#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# Los commits de solo documentación no pagan la suite; código, plantillas y dependencias sí.
if git diff --cached --name-only --diff-filter=ACMR | grep -Eq '(\.py$|^templates/|^scripts/|^pyproject\.toml$|^uv\.lock$)'; then
    ./scripts/check.sh
fi
